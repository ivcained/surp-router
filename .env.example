# surp.ivc.lol — environment configuration
#
# Copy to .env and fill in real values. .env is gitignored and never committed.

# ─── Surplus Intelligence marketplace ──────────────────────────────────────────
# Your Surplus API key (starts with inf_). Required for the resolver proxy.
SURPLUS_INTELLIGENCE_API_KEY=

# ─── x402 payment configuration ────────────────────────────────────────────────
# The wallet address that receives USDC payments. MUST be set in production.
# Default is a throwaway zero address — requests will fail until set.
SURP_PAY_TO=0x0000000000000000000000000000000000000000

# USDC contract address. Defaults to Base Sepolia testnet USDC.
# For Base MAINNET, set to: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
SURP_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# x402 facilitator URL. Default is the x402.org testnet facilitator.
# For production, set to a PayAI facilitator or self-hosted.
FACILITATOR_URL=https://x402.org/facilitator

# ─── Internal resolver ─────────────────────────────────────────────────────────
# The price-resolving proxy (internal only). Default is localhost:20129.
RESOLVER_BASE=http://127.0.0.1:20129

# ─── Benchmark runner (optional) ──────────────────────────────────────────────
# Prepaid API key used by the scheduled benchmark runner.
SURP_BENCH_KEY=

# ─── Community feedback / votes (optional) ───────────────────────────────────
# Salt for hashing voter identities. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SURP_VOTE_SALT=

# ─── Free-tier configuration (optional) ───────────────────────────────────────
# These have sensible defaults; override only to tune.
# SURP_FREE_DAILY_REQUESTS=100
# SURP_FREE_DAILY_TOKENS=100000
# SURP_FREE_MAX_MODEL_USD_PER_1M=0.10
# SURP_FREE_MAX_CODING_USD_PER_1M=0.50
# SURP_FREE_MAX_FAST_USD_PER_1M=0.05

# ─── Artificial Analysis (optional) ───────────────────────────────────────────
# Free key from https://artificialanalysis.ai/api-reference
# Used only to refresh intelligence/speed/list-price snapshots every 6 hours.
# Never required on a user request — routing falls back to the on-disk snapshot.
AA_API_KEY=
# AA_SYNC_SECONDS=21600
