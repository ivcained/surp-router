# surp.ivc.lol — secrets file
#
# Copy this file to `.secrets` and fill in the values, then run the
# create-github-repo script. The `.secrets` file is gitignored and never
# committed.
#
# ──────────────────────────────────────────────────────────────────────────────
# GitHub personal access token
# ──────────────────────────────────────────────────────────────────────────────
# Create a fine-grained PAT at:
#   https://github.com/settings/personal-access-tokens/new
#
# Required permissions:
#   Repository administration: Read and write (to create the repo)
#   Contents: Read and write (to push commits)
#   Metadata: Read-only (required, auto-included)
#
# Scope it to: your account (or a specific organization).
# Set an expiration you're comfortable with (e.g. 30 days).
#
# Paste the token below after creating it. It starts with github_pat_... or ghp_...
GITHUB_PAT=

# ──────────────────────────────────────────────────────────────────────────────
# Repository configuration
# ──────────────────────────────────────────────────────────────────────────────
# Your GitHub username or organization name (e.g. "yourusername")
GITHUB_OWNER=

# Repository name (default: surp-router)
GITHUB_REPO=surp-router

# Visibility: public or private
GITHUB_VISIBILITY=public

# ──────────────────────────────────────────────────────────────────────────────
# Runtime secrets (for the .env.example reference — NOT committed)
# ──────────────────────────────────────────────────────────────────────────────
# These are read by the gateway at runtime. Add them to your server's actual
# .env file (gitignored). The .env.example in the repo documents them without
# values.
SURPLUS_INTELLIGENCE_API_KEY=
SURP_PAY_TO=
SURP_ASSET=
FACILITATOR_URL=
RESOLVER_BASE=
SURP_BENCH_KEY=
SURP_VOTE_SALT=
